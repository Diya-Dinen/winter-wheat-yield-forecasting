# Copy this file to .env and fill in your API keys.
# Never commit .env to version control.

# USDA NASS QuickStats API key
# Register at: https://quickstats.nass.usda.gov/api
NASS_API_KEY=your_nass_api_key_here

# NOAA Climate Data Online (CDO) token
# Register at: https://www.ncdc.noaa.gov/cdo-web/token
NOAA_CDO_TOKEN=your_noaa_cdo_token_here
